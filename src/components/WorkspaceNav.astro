---
import { getWorkspaceFile, workspaceFiles } from "../data/workspace";
import Icon from "./Icon.astro";
import FileIcon from "./FileIcon.astro";
const active = getWorkspaceFile(Astro.url.pathname);
---
<aside class="workspace-sidebar">
  <div class="explorer-heading"><p class="sidebar-caption">Explorer</p><a class="create-message" href="/#message" data-workspace-file="message" data-create-message aria-label="Create message file" title="New message file"><span aria-hidden="true">+</span></a></div>
  <details class="workspace-tree" open>
    <summary class="workspace-folder"><Icon name="chevron" /><Icon name="folder" /><span>yunke-portfolio</span></summary>
    <nav class="workspace-files" aria-label="Portfolio files">
      {workspaceFiles.filter((file) => file.id !== "message").map((file) => (
        <a class="workspace-file" href={file.href} data-workspace-file={file.id} aria-current={active.id === file.id ? "page" : undefined}>
          <FileIcon type={file.type} /><span>{file.label}</span>
        </a>
      ))}
    </nav>
  </details>
</aside>
