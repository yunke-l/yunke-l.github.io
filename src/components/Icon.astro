---
interface Props {
  name: "arrow" | "branch" | "folder" | "chevron" | "code" | "mail";
  class?: string;
}
const { name, class: className = "" } = Astro.props;
const paths = {
  arrow: "M7 17 17 7M7 7h10v10",
  branch: "M6 3v12m0-6c0 0 0 3 6 3s6-3 6-6",
  folder: "M3 7V5a1 1 0 0 1 1-1h5l2 3h9a1 1 0 0 1 1 1v1M3 9h17l-3 11H1L3 9Z",
  chevron: "m6 9 6 6 6-6",
  code: "m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18",
  mail: "M3 5h18v14H3V5Zm0 1 9 7 9-7"
};
---
<svg class:list={["icon", className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
  {name === "branch" && <><circle cx="6" cy="18" r="3" /><circle cx="18" cy="3" r="3" /></>}
</svg>
