---
import Icon from "./Icon.astro";
import Portrait from "./Portrait.astro";
import SocialIcon from "./SocialIcon.astro";
import MessageFile from "./MessageFile.astro";
import ResumeFile from "./ResumeFile.astro";
import RepositoriesFile from "./RepositoriesFile.astro";
import QuizLibraryFeature from "./QuizLibraryFeature.astro";
import LearningDoodle from "./LearningDoodle.astro";
import { currentExperience, education, homeTechnologies, researchHighlight, site } from "../data/site";

---

  <section id="about" class="workspace-pane" data-workspace-pane data-filename="about.md" aria-labelledby="about-title">
    <div class="career-summary" aria-label="Availability and background">
      <div class="career-summary__availability">
        <h2 class="career-summary__status"><span aria-hidden="true"></span>Open to work</h2>
        <p class="career-summary__headline">Full-time · Frontend & Product Engineering</p>
        <p class="career-summary__detail">{site.workAuthorization}</p>
      </div>
      <div class="career-summary__background">
        <p class="career-summary__headline">{education[0].degree}</p>
        <p class="career-summary__detail">{education[0].school}</p>
        <a class="text-link" href="/resume/" data-workspace-file="resume">Read my resume<Icon name="arrow" /></a>
      </div>
    </div>
    <div class="home-hero">
      <div class="home-hero__intro">
        <h1 id="about-title">Hello, world.<br />I'm <span class="accent-text">Yunke.</span></h1>
        <p class="hero-description">I turn ideas into thoughtful interfaces.<br />Building for web and mobile, with care for the details that make products feel right.</p>
        <div class="hero__actions">
          <a class="button button--primary" href="/#work" data-workspace-file="work">Explore my work<Icon name="arrow" /></a>
          <a class="button button--paper" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Let's connect on LinkedIn (opens in a new tab)"><SocialIcon name="linkedin" />Let's connect</a>
        </div>
        <div class="tech-tags home-technologies" aria-label="Technologies I work with">{homeTechnologies.map((technology) => <span>{technology}</span>)}</div>
      </div>
      <div class="profile-code" aria-label="Developer profile">
        <div class="profile-code__header"><span><span class="file-type" aria-hidden="true">TS</span>profile.ts</span></div>
        <div class="profile-identity">
          <Portrait />
          <div><p class="profile-identity__name">{site.name}</p><p>{currentExperience.title}</p><span>Vancouver, BC</span></div>
        </div>
        <pre><code><span class="syntax-keyword">const</span> developer = &#123;
  <span class="syntax-property">name</span>: <span class="syntax-string">'{site.name}'</span>,
  <span class="syntax-property">basedIn</span>: <span class="syntax-string">'Vancouver'</span>,
  <span class="syntax-property">craft</span>: [
    <span class="syntax-string">'Frontend'</span>,
    <span class="syntax-string">'Product engineering'</span>
  ],
  <span class="syntax-property">mindset</span>: <span class="syntax-string">'Keep building'</span>
&#125;;</code></pre>
      </div>
    </div>
  </section>

  <section id="work" class="workspace-pane" data-workspace-pane data-filename="work.tsx" aria-labelledby="work-title">
    <h1 class="pane-title" id="work-title">From ideas to <span class="accent-text">interfaces.</span></h1>
    <article class="experience-panel">
      <div class="feature-card__header"><div><p class="meta">{currentExperience.period}</p><h2>{currentExperience.title}</h2><p>{currentExperience.company}</p></div><p class="feature-card__location">{currentExperience.location}</p></div>
      <div class="experience-signal">
        <div class="experience-signal__label"><LearningDoodle variant="letters" /><p>English-learning platform</p></div>
        <div class="experience-signal__stat"><span class="experience-signal__number">∼30,000</span><p>student tablets</p></div>
        <div class="experience-signal__stat"><span class="experience-signal__number">∼8,000</span><p>daily active devices<br />at peak</p></div>
      </div>
      <ul class="work-highlights" aria-label="Engineering contributions">
        {currentExperience.workAreas.map((area, index) => (
          <li class="work-highlight">
            {index === 1 && <LearningDoodle variant="owl" class="work-highlight__doodle" />}
            <div class="work-highlight__meta"><span class="work-highlight__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><span>{area.stack}</span></div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </li>
        ))}
      </ul>
      <QuizLibraryFeature />
    </article>
  </section>

  <section id="research" class="workspace-pane" data-workspace-pane data-filename="research.py" aria-labelledby="research-title">
    <h1 class="pane-title" id="research-title">Small models. <span class="accent-text">Big questions.</span></h1>
    <p class="page-lead">{researchHighlight.subtitle}<br />Exploring the balance between model accuracy and efficiency in customer review analysis.</p>
    <div class="tech-tags"><span>PyTorch</span><span>distilBERT</span><span>ELECTRA</span><span>Flan-T5</span><span>Flan-UL2</span></div>
    <article class="research-panel">
      <p class="meta">{researchHighlight.period}</p>
      <h2>{researchHighlight.title}</h2>
      <ul class="feature-list">{researchHighlight.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          <div class="hero__actions"><a class="button button--primary" href={researchHighlight.links.code}>Explore the code<Icon name="arrow" /></a><a class="button button--paper" href={researchHighlight.links.paper}>Read paper<Icon name="arrow" /></a></div>
    </article>
    <div class="section-heading"><p class="eyebrow">// Project poster</p></div>
    <figure class="research-poster">
      <a class="research-poster__preview" href={researchHighlight.links.poster} target="_blank" rel="noopener noreferrer" aria-label="Open the full SLMs vs. LLMs research poster (PDF, opens in a new tab)">
        <img src="/assets/img/research/slms-vs-llms-poster.webp" alt="SLMs vs. LLMs project poster showing the research methodology, hybrid model architecture, and results for sentiment classification and correlation analysis." width="2600" height="1463" loading="lazy" decoding="async" />
      </a>
      <figcaption><span>SLMs vs. LLMs · 2024</span><a class="text-link" href={researchHighlight.links.poster} target="_blank" rel="noopener noreferrer">View full-size PDF<Icon name="arrow" /></a></figcaption>
    </figure>
  </section>
  <MessageFile />
  <ResumeFile />
  <RepositoriesFile />
