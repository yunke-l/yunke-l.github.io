---
interface Props {
  name: "linkedin" | "github" | "instagram" | "mail";
}
const { name } = Astro.props;
---
<svg class="social-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === "linkedin" && <>
    <rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor" />
    <path d="M6.2 10h2.6v8H6.2zm1.3-4.1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM10.6 10h2.5v1.1c.5-.8 1.3-1.3 2.5-1.3 2.4 0 2.9 1.5 2.9 3.5V18h-2.6v-4.2c0-1-.1-1.9-1.3-1.9s-1.4 1-1.4 1.9V18h-2.6Z" fill="var(--social-icon-cutout, var(--chrome))" />
  </>}
  {name === "github" && <path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.06c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.67.08-.67 1.12.08 1.7 1.14 1.7 1.14.99 1.7 2.6 1.21 3.23.93.1-.72.39-1.21.7-1.49-2.47-.28-5.06-1.23-5.06-5.48 0-1.21.43-2.2 1.14-2.98-.12-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.2-5.08 5.48.4.34.75 1.02.75 2.06v3.02c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z" />}
  {name === "instagram" && <g stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
  </g>}
  {name === "mail" && <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="4" width="20" height="16" rx="3" />
    <path d="m3 6 9 7 9-7" />
  </g>}
</svg>
