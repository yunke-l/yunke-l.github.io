---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404">
  <section class="page-hero shell">
    <p class="eyebrow">404</p>
    <h1>The page you requested is not here.</h1>
    <p class="page-hero__lead">The portfolio route may have moved while the site was being rebuilt.</p>
    <div class="hero__actions">
      <a class="button button--primary" href="/">Go back home</a>
      <a class="button button--secondary" href="/projects">Browse work</a>
    </div>
  </section>
</BaseLayout>
